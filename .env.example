PORT=3001
HOST=127.0.0.1
SESSION_SECRET=change-me-with-a-long-random-string
STATE_DIR=./state
CHROME_BIN=
TRUST_PROXY=false
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
ALLOW_LOCAL_WEB_SETUP=false

# Monitoreo interno (opcional). Si HEALTH_TOKEN esta vacio, /internal/health no existe.
HEALTH_TOKEN=
ALERT_WEBHOOK_URL=
HEALTH_URL=http://10.0.0.1:3001/internal/health
HEALTH_FAILURE_THRESHOLD=2
HEALTH_ALERT_COOLDOWN_SECONDS=900
HEALTH_STARTUP_GRACE_SECONDS=180
